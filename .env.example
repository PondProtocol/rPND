# Copy to .env and fill in locally. Never commit seeds.
#
# Networks: devnet (MPT-capable), testnet, mainnet
XRPL_NETWORK=devnet
# Optional override. Defaults are in config/tokens.json.
# XRPL_WSS=wss://s.devnet.rippletest.net:51233

# Cold issuing account (family seed, s...). Required for issuance commands.
ISSUER_SEED=

# Hot / operational account. Holds inventory of $PND and $rPND for distribution.
OPERATIONAL_SEED=

# Optional third account used by authorize/send examples.
HOLDER_SEED=

# Treasury account for escrow. Holds and self-escrows the vesting supply;
# never the issuer (an issuer can never escrow its own currency). Falls
# back to OPERATIONAL_SEED if unset, matching the launch plan's note that a
# dedicated treasury is recommended but not required. escrow-finish and
# escrow-cancel accept any funded account (releases are permissionless).
TREASURY_SEED=

# Domain written to the issuer AccountSet and used in xrp-ledger.toml.
# Host https://<domain>/.well-known/xrp-ledger.toml before setting this on mainnet.
ISSUER_DOMAIN=
